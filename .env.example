# App
NODE_ENV=development
PORT=3001
APP_URL=http://localhost:3001
FRONTEND_URL=http://localhost:3000
ADMIN_URL=http://localhost:3002

# MongoDB Atlas
MONGODB_URI=MONGODB_URI

# JWT
JWT_SECRET=JWT_SECRET
JWT_EXPIRES_IN=1d
JWT_REFRESH_SECRET=JWT_REFRESH_SECRET
JWT_REFRESH_EXPIRES_IN=7d

# Redis (Upstash)
REDIS_URL=REDIS_URL

# Cloudinary
CLOUDINARY_CLOUD_NAME=CLOUDINARY_CLOUD_NAME
CLOUDINARY_API_KEY=CLOUDINARY_API_KEY
CLOUDINARY_API_SECRET=CLOUDINARY_API_SECRET

# Google OAuth
GOOGLE_CLIENT_ID=GOOGLE_CLIENT_ID
GOOGLE_CLIENT_SECRET=GOOGLE_CLIENT_SECRET
GOOGLE_CALLBACK_URL=GOOGLE_CALLBACK_URL

# Facebook OAuth
FACEBOOK_APP_ID=FACEBOOK_APP_ID
FACEBOOK_APP_SECRET=FACEBOOK_APP_SECRET
FACEBOOK_CALLBACK_URL=FACEBOOK_CALLBACK_URL

# Email (Gmail SMTP)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USER=your-email@gmail.com
MAIL_PASS=your-app-password
MAIL_FROM=WEB-EC-3D <noreply@web-ec-3d.com>

# Rate Limiting
THROTTLE_TTL=60
THROTTLE_LIMIT=100

# Zalo Bot — thông báo ĐƠN HÀNG MỚI tới Zalo cá nhân của chủ shop.
# Xem docs/ZALO_BOT_INTEGRATION.md. KHÔNG commit giá trị thật. Tắt mặc định.
ZALO_BOT_ENABLED=false
# Token Bot (bí mật — chỉ đặt ở Render Environment, không bao giờ ở frontend).
ZALO_BOT_TOKEN=
# Chat id chủ shop được duyệt sẵn, phân tách bằng dấu phẩy (có thể để trống và duyệt trong Admin).
ZALO_OWNER_CHAT_IDS=
# Secret 8–256 ký tự, Zalo gửi lại trong header X-Bot-Api-Secret-Token.
ZALO_BOT_WEBHOOK_SECRET=
ZALO_BOT_BASE_URL=https://bot-api.zaloplatforms.com
# URL webhook công khai (HTTPS), vd. https://<backend-domain>/api/v1/webhooks/zalo-bot
ZALO_BOT_WEBHOOK_URL=
ZALO_BOT_REQUEST_TIMEOUT_MS=10000
ZALO_BOT_MAX_RETRIES=3
ZALO_BOT_RETRY_BASE_DELAY_MS=30000
# Chu kỳ worker (ms); 0 = tắt worker trên instance này.
ZALO_BOT_WORKER_INTERVAL_MS=15000
# Domain Admin cho link "Xem đơn hàng" — để trống sẽ dùng ADMIN_URL.
ZALO_BOT_ADMIN_URL=

# ─── Zalo ZBS — tin xác nhận đơn hàng cho KHÁCH (ORDER_CREATED → ORDER_CONFIRMATION) ───
# Xem docs/ZALO_ZBS_INTEGRATION.md. KHÔNG commit giá trị thật. Độc lập hoàn toàn với ZALO_BOT_*.
# Chỉ bật (true) khi đã qua toàn bộ checklist kích hoạt (§16 trong tài liệu).
ZALO_ZBS_ENABLED=false
# App ID + Secret key của ứng dụng trên developers.zalo.me (secret: KHÔNG lộ ra frontend/log).
ZALO_ZBS_APP_ID=
ZALO_ZBS_APP_SECRET=
# ID của Official Account đã xác thực (hiển thị trong admin, đối chiếu khi ủy quyền).
ZALO_ZBS_OA_ID=
# Token OA dùng để NẠP LẦN ĐẦU. Refresh token chỉ dùng được 1 lần và xoay vòng → sau lần làm mới
# đầu tiên, token mới được lưu (mã hóa) trong MongoDB. Đổi giá trị này = ủy quyền lại (nạp lại).
ZALO_ZBS_ACCESS_TOKEN=
ZALO_ZBS_REFRESH_TOKEN=
# Khóa AES-256 (32 byte, 64 ký tự hex hoặc base64) để mã hóa token lưu trong DB.
# Tạo: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ZALO_ZBS_TOKEN_ENCRYPTION_KEY=
# Template ID của template ORDER_CONFIRMATION đã được Zalo duyệt (trạng thái ENABLE).
ZALO_ZBS_TEMPLATE_ORDER_CONFIRMATION=
# Map tham số ĐÚNG TÊN trong template đã duyệt → dữ liệu đơn. Nguồn hợp lệ: customerName, orderCode,
# orderId, orderTotal, orderTotalNumber, orderStatus, orderDate, orderDateTime, itemCount,
# paymentMethod, paymentStatus, orderUrl, hoặc "const:<chữ cố định>". Ví dụ (CHỈ minh họa):
# {"customer_name":"customerName","order_code":"orderCode","order_total":"orderTotal","order_status":"orderStatus"}
ZALO_ZBS_ORDER_CONFIRMATION_PARAMS=
# Chỉ dùng khi app KHÔNG có quyền "Quản lý Message Template": đặt = Template ID sau khi đã tự kiểm tra
# trên ZBS rằng template ENABLE và tham số khớp. Để trống nếu dùng nút "Kiểm tra template".
ZALO_ZBS_TEMPLATE_MANUALLY_VERIFIED=
# Domain storefront cho tham số orderUrl (nếu template có nút xem đơn). Trống = FRONTEND_URL.
ZALO_ZBS_ORDER_URL_BASE=
ZALO_ZBS_API_BASE_URL=https://business.openapi.zalo.me
ZALO_ZBS_OAUTH_BASE_URL=https://oauth.zaloapp.com
ZALO_ZBS_REQUEST_TIMEOUT_MS=10000
# Số lần thử lại tự động cho lỗi tạm thời (0–5). Lỗi không rõ kết quả KHÔNG bao giờ tự gửi lại.
ZALO_ZBS_MAX_RETRIES=3
ZALO_ZBS_RETRY_BASE_DELAY_MS=30000
# Chu kỳ worker (ms). 0 = tắt worker trên instance này.
ZALO_ZBS_WORKER_INTERVAL_MS=15000
# Giới hạn an toàn nội bộ số tin/ngày (giờ VN). 0 = không giới hạn (vẫn chịu quota của Zalo).
ZALO_ZBS_DAILY_SEND_LIMIT=0
# Đơn giá (VND/tin) chỉ để ƯỚC TÍNH chi phí trong admin. 0 = lấy price_sdt từ thông tin template.
ZALO_ZBS_UNIT_PRICE_VND=0

# ─── Zalo OA Welcome Reward (quà 20% khi quan tâm Zalo OA sau khi đặt hàng) ───────────────
# Xem docs/ZALO_OA_REWARD_INTEGRATION.md. Tách biệt hoàn toàn với ZALO_BOT_* và ZALO_ZBS_*:
# KHÔNG dùng lại secret của Bot/ZBS. Không có mã liên kết, không OTP.
ZALO_OA_REWARD_ENABLED=false
# ID và trang OA (https://zalo.me/<OA_ID>) — khách được đưa tới đây để nhấn "Quan tâm".
ZALO_OA_ID=
ZALO_OA_URL=
ZALO_OA_NAME=Luxe Glow
# Zalo App ĐÃ LIÊN KẾT với OA. Webhook OA trả user_id_by_app theo app này; Zalo Login dùng cùng app.
ZALO_OA_APP_ID=
# Secret key của Zalo App (header secret_key khi đổi code + appsecret_proof khi gọi /me). Bí mật.
ZALO_OA_APP_SECRET=
# "OA Secret Key" trong trang Webhook của app — dùng kiểm tra X-ZEvent-Signature. Bí mật.
ZALO_OA_WEBHOOK_SECRET=
# social_login (mặc định: Zalo Login trên web, OAuth v4 + PKCE) | mini_app (cần Mini App riêng).
ZALO_OA_LINK_MODE=social_login
# Callback Zalo Login — phải khai báo y hệt trong Quản lý ứng dụng → Đăng nhập.
# Production: https://api.luxe-glow.vn/api/v1/zalo-oa-reward/oauth/callback
ZALO_OA_OAUTH_REDIRECT_URI=
# Chỉ khi ZALO_OA_LINK_MODE=mini_app.
ZALO_OA_MINI_APP_ID=
# Chương trình + mã giảm giá CÓ SẴN (hai thực thể khác nhau — không đổi chỗ cho nhau).
ZALO_OA_PROMOTION_ID=6ad48f1007c02f629c44496a
ZALO_OA_COUPON_ID=6ad48f8007c02f629c4449a3
# Trống = FRONTEND_URL (trang /zalo-reward sau bước Zalo).
ZALO_OA_REWARD_FRONTEND_URL=
ZALO_OA_REWARD_ORDER_MAX_AGE_HOURS=72
ZALO_OA_REWARD_LINK_TTL_MINUTES=60
# Chờ sự kiện follow đã ký bao lâu trước khi báo "chưa thể tự động xác nhận".
ZALO_OA_REWARD_FOLLOW_TIMEOUT_MINUTES=10
# Zalo retry webhook tới ~2 giờ sau → nhận sự kiện trong 3 giờ.
ZALO_OA_WEBHOOK_MAX_AGE_SECONDS=10800
ZALO_OA_REQUEST_TIMEOUT_MS=10000
